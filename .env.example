# Copy to .env and fill in. Never commit .env.

PORT=3000
CLUB_NAME=Club Attendance
TIMEZONE=Asia/Kolkata

# --- Geofence (get coordinates: Google Maps -> long-press venue -> tap the numbers) ---
VENUE_LAT=18.4636
VENUE_LNG=73.8681
RADIUS_METERS=75
# Reject readings whose GPS accuracy is worse than this (indoors GPS can be poor)
MAX_GPS_ACCURACY_METERS=100

# --- Face matching ---
# Lower = stricter. 0.45 strict, 0.5 balanced, 0.6 lenient (face-api.js default)
FACE_MATCH_THRESHOLD=0.5

# --- Security ---
# Secret code the club heads share so only real members can enroll a face
ENROLL_CODE=change-me-before-use
# 64 hex chars. Generate with: npm run gen-key
ENCRYPTION_KEY=

# --- Google Sheets (service account) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON file in one line, keeping the \n sequences, inside quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
